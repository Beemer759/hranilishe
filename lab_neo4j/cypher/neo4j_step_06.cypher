// Социальный граф: узлы-группы (:Group)

// три группы персонажей
CREATE (g1:Group {name: "Следственная группа", kind: "команда", purpose: "расследование дела"}),
       (g2:Group {name: "Семья Крамер", kind: "семья", purpose: "поддержка родных"}),
       (g3:Group {name: "Клуб «Полночь»", kind: "сообщество", purpose: "досуг и творчество"})
RETURN g1, g2, g3;

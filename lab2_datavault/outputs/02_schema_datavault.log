-- ============================================================================
--  Лабораторная работа №2. Хранилища данных. Вариант 6.
--  Тема: «Система учебного графика дисциплин факультета».
--  Часть 2. МОДЕЛЬ DATA VAULT 2.0.
--
--  СУБД: PostgreSQL 18.4 (Windows).  Схема: dv
--
--  По методологии Data Vault (Д. Линстедт) модель состоит из трёх типов
--  объектов (см. лекцию «Введение в Data Vault»):
--    * Хаб (Hub)   — сущность бизнеса с бизнес-ключом (бизнес-ключ уникален
--                    и неизменен; в качестве PK рекомендован хэш MD5 от
--                    бизнес-ключа) + метаполя load_date и record_source;
--    * Ссылка (Link) — связь «многие-ко-многим» между хабами (или хабом и
--                    ссылкой), с теми же метаполями;
--    * Сателлит (Sat) — весь контекст (описательные атрибуты) хаба или
--                    ссылки: один ключ «родителя», load_date,
--                    record_source, hashdiff (MD5 от всех описательных
--                    атрибутов) и границы жизни записи (load_end_date),
--                    что позволяет хранить историю изменений.
--
--  Хэши рассчитываются автоматически:
--    * у Хабов  — GENERATED ALWAYS AS (md5(бизнес_ключ)),
--    * у Ссылок — GENERATED ALWAYS AS (md5(хэши участников [+ слот])),
--    * у Сателлитов — GENERATED ALWAYS AS (md5(всех описательных атрибутов)).
--  Метаполя имеют DEFAULT now() / текстовые значения источника.
--
--  Примечание: конкатенация выполняется оператором || (постоянный), а не
--  функциями concat/concat_ws — у тех волатильность STABLE, и PostgreSQL
--  отклоняет их в генерируемых выражениях («генерирующее выражение не
--  является постоянным»).
-- ============================================================================
\echo '=== [Data Vault] Создание схемы dv ==='
=== [Data Vault] Создание схемы dv ===
DROP SCHEMA IF EXISTS dv CASCADE;
psql:C:/Users/�������������/Desktop/���������/�/lab2_datavault/sql/02_schema_datavault.sql:34: ЗАМЕЧАНИЕ:  схема "dv" не существует, пропускается
CREATE SCHEMA dv;
SET search_path TO dv, public;
-- ============================================================================
--  ХАБЫ (Hub)
-- ============================================================================
-- Хаб: кафедра. Бизнес-ключ — код кафедры.
CREATE TABLE dv.hub_kafedra (
    kod_kafedry   varchar(10)  NOT NULL,                       -- бизнес-ключ
    hash_kafedra  char(32)     GENERATED ALWAYS AS (md5(kod_kafedry)) STORED
                                PRIMARY KEY,
    load_date     timestamp    NOT NULL DEFAULT now(),         -- мета: дата загрузки
    record_source varchar(60)  NOT NULL DEFAULT 'uchplan_1c'   -- мета: источник
);
COMMENT ON TABLE dv.hub_kafedra IS 'Хаб: кафедра факультета (бизнес-ключ — код кафедры)';
-- Хаб: направление подготовки. Бизнес-ключ — кодификатор (шифр) направления.
CREATE TABLE dv.hub_specialnost (
    kodifikator      varchar(20) NOT NULL,
    hash_specialnost char(32)    GENERATED ALWAYS AS (md5(kodifikator)) STORED
                                 PRIMARY KEY,
    load_date        timestamp   NOT NULL DEFAULT now(),
    record_source    varchar(60) NOT NULL DEFAULT 'uchplan_1c'
);
COMMENT ON TABLE dv.hub_specialnost IS 'Хаб: специальность (направление подготовки)';
-- Хаб: учебная группа. Бизнес-ключ — наименование группы.
CREATE TABLE dv.hub_gruppa (
    nazvanie      varchar(20) NOT NULL,
    hash_gruppa   char(32)    GENERATED ALWAYS AS (md5(nazvanie)) STORED
                              PRIMARY KEY,
    load_date     timestamp   NOT NULL DEFAULT now(),
    record_source varchar(60) NOT NULL DEFAULT 'uchplan_1c'
);
COMMENT ON TABLE dv.hub_gruppa IS 'Хаб: учебная группа (бизнес-ключ — название группы)';
-- Хаб: дисциплина. Бизнес-ключ — кодификатор (шифр) дисциплины.
CREATE TABLE dv.hub_disciplina (
    shifr          varchar(20) NOT NULL,
    hash_disciplina char(32)   GENERATED ALWAYS AS (md5(shifr)) STORED
                               PRIMARY KEY,
    load_date      timestamp   NOT NULL DEFAULT now(),
    record_source  varchar(60) NOT NULL DEFAULT 'uchplan_1c'
);
COMMENT ON TABLE dv.hub_disciplina IS 'Хаб: дисциплина учебного плана (бизнес-ключ — шифр дисциплины)';
-- Хаб: преподаватель. Бизнес-ключ — табельный номер.
CREATE TABLE dv.hub_prepodavatel (
    tab_nomer        varchar(12) NOT NULL,
    hash_prepodavatel char(32)   GENERATED ALWAYS AS (md5(tab_nomer)) STORED
                                 PRIMARY KEY,
    load_date        timestamp   NOT NULL DEFAULT now(),
    record_source    varchar(60) NOT NULL DEFAULT 'kadry_prepodavatelei'
);
COMMENT ON TABLE dv.hub_prepodavatel IS 'Хаб: преподаватель (бизнес-ключ — табельный номер)';
-- Хаб: аудитория. Бизнес-ключ — «Корпус-Номер» (номер аудитории сам по себе
-- не уникален между корпусами, поэтому ключ составляется из двух полей
-- источника и хранится одной неизменяемой строкой).
CREATE TABLE dv.hub_auditoriya (
    aud_key        varchar(30) NOT NULL,   -- бизнес-ключ: «А-421»
    hash_auditoriya char(32)   GENERATED ALWAYS AS (md5(aud_key)) STORED
                               PRIMARY KEY,
    load_date      timestamp   NOT NULL DEFAULT now(),
    record_source  varchar(60) NOT NULL DEFAULT 'spravochnik_auditorii'
);
COMMENT ON TABLE dv.hub_auditoriya IS 'Хаб: аудитория (бизнес-ключ — «Корпус-Номер», напр. А-421)';
-- ============================================================================
--  ССЫЛКИ (Link)
-- ============================================================================
-- Ссылка: группа изучает специальность (направление подготовки).
CREATE TABLE dv.link_gruppa_specialnost (
    hash_gruppa      char(32) NOT NULL REFERENCES dv.hub_gruppa(hash_gruppa),
    hash_specialnost char(32) NOT NULL REFERENCES dv.hub_specialnost(hash_specialnost),
    hash_link        char(32) GENERATED ALWAYS AS
                     (md5(hash_gruppa || '|' || hash_specialnost)) STORED
                     PRIMARY KEY,
    load_date        timestamp  NOT NULL DEFAULT now(),
    record_source    varchar(60) NOT NULL DEFAULT 'uchplan_1c'
);
COMMENT ON TABLE dv.link_gruppa_specialnost IS 'Ссылка: группа — направление подготовки (многие-ко-многим)';
-- Ссылка: преподаватель работает на кафедре.
CREATE TABLE dv.link_prepodavatel_kafedra (
    hash_prepodavatel char(32) NOT NULL REFERENCES dv.hub_prepodavatel(hash_prepodavatel),
    hash_kafedra      char(32) NOT NULL REFERENCES dv.hub_kafedra(hash_kafedra),
    hash_link         char(32) GENERATED ALWAYS AS
                      (md5(hash_prepodavatel || '|' || hash_kafedra)) STORED
                      PRIMARY KEY,
    load_date         timestamp  NOT NULL DEFAULT now(),
    record_source     varchar(60) NOT NULL DEFAULT 'kadry_prepodavatelei'
);
COMMENT ON TABLE dv.link_prepodavatel_kafedra IS 'Ссылка: преподаватель — кафедра';
-- Ссылка: дисциплину ведёт кафедра.
CREATE TABLE dv.link_disciplina_kafedra (
    hash_disciplina char(32) NOT NULL REFERENCES dv.hub_disciplina(hash_disciplina),
    hash_kafedra    char(32) NOT NULL REFERENCES dv.hub_kafedra(hash_kafedra),
    hash_link       char(32) GENERATED ALWAYS AS
                    (md5(hash_disciplina || '|' || hash_kafedra)) STORED
                    PRIMARY KEY,
    load_date       timestamp  NOT NULL DEFAULT now(),
    record_source   varchar(60) NOT NULL DEFAULT 'uchplan_1c'
);
COMMENT ON TABLE dv.link_disciplina_kafedra IS 'Ссылка: дисциплина — ведущая кафедра';
-- Ссылка: занятие учебного графика (событийная связь).
-- Соединяет четыре хаба и фиксирует слот расписания; состав слота
-- (день недели, номер пары, четность недели) входит в бизнес-ключ ссылки,
-- поэтому каждая строка — отдельное уникальное занятие в графике.
CREATE TABLE dv.link_zanyatie (
    hash_gruppa       char(32) NOT NULL REFERENCES dv.hub_gruppa(hash_gruppa),
    hash_disciplina   char(32) NOT NULL REFERENCES dv.hub_disciplina(hash_disciplina),
    hash_prepodavatel char(32) NOT NULL REFERENCES dv.hub_prepodavatel(hash_prepodavatel),
    hash_auditoriya   char(32) NOT NULL REFERENCES dv.hub_auditoriya(hash_auditoriya),
    den_nedeli        smallint NOT NULL CHECK (den_nedeli BETWEEN 1 AND 7),
    para              smallint NOT NULL CHECK (para BETWEEN 1 AND 6),
    nedelya           varchar(10) NOT NULL CHECK (nedelya IN ('все','четная','нечетная')),
    hash_link         char(32) GENERATED ALWAYS AS
                      (md5(hash_gruppa || '|' || hash_disciplina || '|' || hash_prepodavatel || '|' || hash_auditoriya || '|' || den_nedeli::text || '|' || para::text || '|' || nedelya))
                      STORED PRIMARY KEY,
    load_date         timestamp  NOT NULL DEFAULT now(),
    record_source     varchar(60) NOT NULL DEFAULT 'portal_raspisaniya'
);
COMMENT ON TABLE  dv.link_zanyatie IS 'Ссылка (событие): занятие = группа × дисциплина × преподаватель × аудитория × слот';
COMMENT ON COLUMN dv.link_zanyatie.den_nedeli IS 'День недели: 1 — понедельник … 7 — воскресенье';
COMMENT ON COLUMN dv.link_zanyatie.nedelya    IS 'Четность недели (все / четная / нечетная)';
-- ============================================================================
--  САТЕЛЛИТЫ (Satellite)
-- ============================================================================
CREATE TABLE dv.sat_kafedra (
    hash_kafedra  char(32)     NOT NULL REFERENCES dv.hub_kafedra(hash_kafedra),
    nazvanie      varchar(150) NOT NULL,
    telefon       varchar(20),
    hashdiff      char(32)     GENERATED ALWAYS AS
                  (md5(coalesce(nazvanie,'') || '|' || coalesce(telefon,''))) STORED,
    load_date     timestamp    NOT NULL DEFAULT now(),
    load_end_date timestamp,                       -- NULL — текущая версия
    record_source varchar(60)  NOT NULL DEFAULT 'uchplan_1c',
    PRIMARY KEY (hash_kafedra, load_date)
);
COMMENT ON TABLE dv.sat_kafedra IS 'Сателлит: контекст кафедры (название, телефон), история изменений';
CREATE TABLE dv.sat_specialnost (
    hash_specialnost char(32)     NOT NULL REFERENCES dv.hub_specialnost(hash_specialnost),
    nazvanie         varchar(200) NOT NULL,
    uroven           varchar(20)  NOT NULL,
    hashdiff         char(32)     GENERATED ALWAYS AS
                     (md5(nazvanie || '|' || uroven)) STORED,
    load_date        timestamp    NOT NULL DEFAULT now(),
    load_end_date    timestamp,
    record_source    varchar(60)  NOT NULL DEFAULT 'uchplan_1c',
    PRIMARY KEY (hash_specialnost, load_date)
);
COMMENT ON TABLE dv.sat_specialnost IS 'Сателлит: контекст направления подготовки';
CREATE TABLE dv.sat_gruppa (
    hash_gruppa    char(32)   NOT NULL REFERENCES dv.hub_gruppa(hash_gruppa),
    kurs           smallint   NOT NULL,
    god_postupleniya smallint NOT NULL,
    hashdiff       char(32)   GENERATED ALWAYS AS
                   (md5(kurs::text || '|' || god_postupleniya::text)) STORED,
    load_date      timestamp  NOT NULL DEFAULT now(),
    load_end_date  timestamp,
    record_source  varchar(60) NOT NULL DEFAULT 'uchplan_1c',
    PRIMARY KEY (hash_gruppa, load_date)
);
COMMENT ON TABLE dv.sat_gruppa IS 'Сателлит: контекст группы (курс, год поступления)';
CREATE TABLE dv.sat_disciplina (
    hash_disciplina char(32)     NOT NULL REFERENCES dv.hub_disciplina(hash_disciplina),
    nazvanie        varchar(200) NOT NULL,
    semestr         smallint     NOT NULL,
    chasy_lek       smallint     NOT NULL,
    chasy_prakt     smallint     NOT NULL,
    chasy_lab       smallint     NOT NULL,
    hashdiff        char(32)     GENERATED ALWAYS AS
                    (md5(nazvanie || '|' || semestr::text || '|' || chasy_lek::text || '|' || chasy_prakt::text || '|' || chasy_lab::text)) STORED,
    load_date       timestamp    NOT NULL DEFAULT now(),
    load_end_date   timestamp,
    record_source   varchar(60)  NOT NULL DEFAULT 'uchplan_1c',
    PRIMARY KEY (hash_disciplina, load_date)
);
COMMENT ON TABLE dv.sat_disciplina IS 'Сателлит: контекст дисциплины (название, семестр, часы)';
CREATE TABLE dv.sat_prepodavatel (
    hash_prepodavatel char(32)    NOT NULL REFERENCES dv.hub_prepodavatel(hash_prepodavatel),
    fio               varchar(120) NOT NULL,
    dolzhnost         varchar(60)  NOT NULL,
    email             varchar(80)  NOT NULL,
    hashdiff          char(32)     GENERATED ALWAYS AS
                      (md5(fio || '|' || dolzhnost || '|' || email)) STORED,
    load_date         timestamp    NOT NULL DEFAULT now(),
    load_end_date     timestamp,
    record_source     varchar(60)  NOT NULL DEFAULT 'kadry_prepodavatelei',
    PRIMARY KEY (hash_prepodavatel, load_date)
);
COMMENT ON TABLE dv.sat_prepodavatel IS 'Сателлит: контекст преподавателя (ФИО, должность, e-mail)';
CREATE TABLE dv.sat_auditoriya (
    hash_auditoriya char(32)    NOT NULL REFERENCES dv.hub_auditoriya(hash_auditoriya),
    nomer           varchar(10) NOT NULL,
    korpus          varchar(40) NOT NULL,   -- контекст хранится денормализованно
    tip             varchar(40) NOT NULL,
    vmestimost      integer     NOT NULL,
    hashdiff        char(32)    GENERATED ALWAYS AS
                    (md5(nomer || '|' || korpus || '|' || tip || '|' || vmestimost::text)) STORED,
    load_date       timestamp   NOT NULL DEFAULT now(),
    load_end_date   timestamp,
    record_source   varchar(60) NOT NULL DEFAULT 'spravochnik_auditorii',
    PRIMARY KEY (hash_auditoriya, load_date)
);
COMMENT ON TABLE dv.sat_auditoriya IS 'Сателлит: контекст аудитории (номер, корпус, тип, вместимость) — в Data Vault контекст намеренно денормализован';
CREATE TABLE dv.sat_zanyatie (
    hash_link      char(32)    NOT NULL REFERENCES dv.link_zanyatie(hash_link),
    tip_zanyatiya  varchar(15) NOT NULL,
    hashdiff       char(32)    GENERATED ALWAYS AS (md5(tip_zanyatiya)) STORED,
    load_date      timestamp   NOT NULL DEFAULT now(),
    load_end_date  timestamp,
    record_source  varchar(60) NOT NULL DEFAULT 'portal_raspisaniya',
    PRIMARY KEY (hash_link, load_date)
);
COMMENT ON TABLE dv.sat_zanyatie IS 'Сателлит: контекст занятия (вид занятия), привязан к ссылке-событию';
-- ----------------------------------------------------------------------------
-- Индексы по внешним ключам (хэш-ключи уже проиндексированы как PK)
-- ----------------------------------------------------------------------------
CREATE INDEX idx_sat_kafedra_hash      ON dv.sat_kafedra(hash_kafedra);
CREATE INDEX idx_sat_disciplina_hash   ON dv.sat_disciplina(hash_disciplina);
CREATE INDEX idx_sat_prepod_hash       ON dv.sat_prepodavatel(hash_prepodavatel);
CREATE INDEX idx_link_zanyatie_gruppa  ON dv.link_zanyatie(hash_gruppa);
CREATE INDEX idx_link_zanyatie_slot    ON dv.link_zanyatie(den_nedeli, para);
